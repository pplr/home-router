sstate-cache/
downloads/
*.swp
*~
build/cache
build/tmp
build/*.sock
build/*.log
build/bitbake.lock

# Out-of-tree secrets baked into the image at build time.
# README.md is the only file in this directory that's tracked.
layers/meta-futro-s920/files/secrets/*
!layers/meta-futro-s920/files/secrets/README.md

# AP build artifacts and out-of-tree AP secrets (same convention).
aps/downloads/
aps/build/
aps/secrets/*
!aps/secrets/README.md

# Python bytecode, anywhere — the build drivers (aps/apbuild, routerbuild)
# and the wic plugins under layers/ all get imported and leave caches behind.
__pycache__/
*.py[cod]
