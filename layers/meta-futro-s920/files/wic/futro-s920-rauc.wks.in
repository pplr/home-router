# short-description: A/B partition layout for Futro S920 with RAUC (barebox)
# long-description: GPT disk image with EFI boot (barebox), state partition
# for bootchooser, dual rootfs (A/B), and persistent data partition.

# Partition 1: EFI System Partition (barebox.efi + state.dtb)
part /boot --source bootimg-barebox-efi --sourceparams="state-dtb=state.dtb" --ondisk sda --label boot --active --align 1024 --fixed-size 64M --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --uuid=f7200001-a001-4000-8001-000000000001

# Partition 2: Barebox state backend (bootchooser persistent state)
part --source empty --sourceparams="fill" --ondisk sda --label state --align 1024 --fixed-size 1M --part-type=4778ed65-bf42-45fa-9c5b-287a1dc4aab1 --uuid=f7200002-a001-4000-8001-000000000002

# Partition 3: Root filesystem slot A
part / --source rootfs --ondisk sda --fstype=ext4 --label rootfs-a --align 1024 --fixed-size 1024M --no-fstab-update --uuid=f7200003-a001-4000-8001-000000000003

# Partition 4: Root filesystem slot B (empty, populated by RAUC)
part --ondisk sda --fstype=ext4 --label rootfs-b --align 1024 --fixed-size 1024M --uuid=f7200004-a001-4000-8001-000000000004

# Partition 5: Persistent data (logs, config, certs)
part /data --ondisk sda --fstype=ext4 --label data --align 1024 --size 5100M --uuid=f7200005-a001-4000-8001-000000000005

# Stable GPT disk GUID: referenced by barebox's storage-by-uuid binding
# in recipes-bsp/barebox/barebox/state.dts so the state driver can locate
# the disk at boot.
bootloader --ptable gpt --diskid=f7200000-a001-4000-8001-000000000000
