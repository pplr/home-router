[Unit]
Description=Create /data subdirs for persistent state bind mounts
DefaultDependencies=no
RequiresMountsFor=/data
After=data.mount
Before=var-log-journal.mount var-lib-systemd-network.mount var-lib-systemd-journal\x2dupload.mount var-lib-victoria\x2dmetrics.mount var-lib-victoria\x2dlogs.mount home-pplr.mount systemd-journald.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/mkdir -p /data/var/log/journal /data/var/lib/systemd/network /data/var/lib/systemd/journal-upload /data/var/lib/victoria-metrics /data/var/lib/victoria-logs /data/home
ExecStart=/bin/chmod 2755 /data/var/log/journal
ExecStart=/bin/chgrp systemd-journal /data/var/log/journal
ExecStart=/bin/chown systemd-journal-upload:systemd-journal-upload /data/var/lib/systemd/journal-upload
ExecStart=/bin/chown victoria-metrics:victoria-metrics /data/var/lib/victoria-metrics
ExecStart=/bin/chown victoria-logs:victoria-logs /data/var/lib/victoria-logs
# Seed pplr's home from the rootfs skeleton on first boot; preserved across A/B swaps.
ExecStart=/bin/sh -c '[ -e /data/home/pplr ] || cp -a /home/pplr /data/home/'

[Install]
WantedBy=local-fs.target
