[Match]
Name=br-iptv

[Network]
# L2-only bridge — transparently ferries Freebox IPTV VLAN 100 frames between
# wan0.100 (toward Freebox Server) and lan0.100 / lan1.100 (toward Players).
# No IP stack on the router for this VLAN.
LinkLocalAddressing=no
IPv6AcceptRA=no
LLDP=no
EmitLLDP=no
ConfigureWithoutCarrier=yes
# Reverse-path filtering on this IP-less L2 bridge has no value (no routing
# decision to protect) but trips the kernel martian-source logger on every
# Freebox-Player gateway ARP (~1 Hz). Disable it here; WAN martian logging
# (net.ipv4.conf.all.log_martians=1) stays intact for genuine threats.
IPv4ReversePathFilter=no
